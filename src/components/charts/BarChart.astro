---
import { useTranslations, type Lang } from '../../i18n/ui';
import { CHANNELS } from '../../lib/sample-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Ranking across categories. Horizontal, because channel names are long and
// vertical bars would force rotated labels — and always sorted, because an
// unsorted ranking chart is not a ranking chart.
//
// One hue for every bar, not a ramp: the bar's length already encodes
// magnitude, so colouring by value would say the same thing twice. Single
// series, so no legend box — the title names what is plotted.
const X0 = 168;
const X1 = 596;
const MAX = 500;
const ROW = 42;
const BAR = 20;
const R = 4;

const sx = (v: number) => X0 + (v / MAX) * (X1 - X0);
const total = CHANNELS.reduce((a, c) => a + c.value, 0);

const bars = CHANNELS.map((c, i) => {
  const y = 14 + i * ROW;
  const w = sx(c.value) - X0;
  return {
    name: t(`demo.channel.${c.key}` as 'demo.channel.direct'),
    value: c.value,
    y,
    w,
    // 4px rounded data-end, square at the baseline — the bar grows from one
    // side, so only that side is rounded.
    d: `M${X0} ${y} H${X0 + w - R} A${R} ${R} 0 0 1 ${X0 + w} ${y + R} V${y + BAR - R} A${R} ${R} 0 0 1 ${X0 + w - R} ${y + BAR} H${X0} Z`,
    share: ((c.value / total) * 100).toFixed(1),
  };
});

const ticks = [0, 125, 250, 375, 500];
const H = 14 + CHANNELS.length * ROW + 34;
const uid = 'br';
---

<figure class="chart card" data-chart>
  <figcaption class="chart-cap">
    <div>
      <h3 class="chart-title">{t('demo.channels.title')}</h3>
      <p class="label mt-1.5">{t('demo.channels.unit')}</p>
    </div>
    <p class="label">{total.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-GB')} total</p>
  </figcaption>

  <svg viewBox={`0 0 700 ${H}`} role="img" aria-label={t('demo.channels.title')}>
    <defs>
      {
        bars.map((_, i) => (
          <clipPath id={`${uid}-grow-${i}`}>
            <rect class="grow-rect" style={`--i:${i}`} x="0" y="0" width="700" height={H} />
          </clipPath>
        ))
      }
    </defs>

    {
      ticks.map((v) => (
        <>
          <line class="gridline" x1={sx(v)} y1="8" x2={sx(v)} y2={14 + CHANNELS.length * ROW} />
          <text class="axis-text" x={sx(v)} y={H - 10} text-anchor="middle">
            {v}
          </text>
        </>
      ))
    }

    {
      bars.map((b, i) => (
        <>
          <text class="mark-label" x={X0 - 14} y={b.y + BAR / 2 + 4} text-anchor="end">
            {b.name}
          </text>
          <g clip-path={`url(#${uid}-grow-${i})`}>
            <path d={b.d} fill="var(--color-series-1)" />
            {/* Bars → value at the tip. */}
            <text class="mark-value" x={X0 + b.w + 10} y={b.y + BAR / 2 + 4}>
              {b.value}
            </text>
          </g>
        </>
      ))
    }

    <line class="axisline" x1={X0} y1="8" x2={X0} y2={14 + CHANNELS.length * ROW}></line>
  </svg>
</figure>

<style>
  .grow-rect {
    transform-box: fill-box;
    transform-origin: left;
  }

  /* Hover grows the bars out of their axis, one after the next. Clipping a
     rectangle rather than scaling the bar keeps the rounded tip from squashing
     while it grows. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .chart:hover .grow-rect {
      animation-name: grow-bar;
      animation-duration: 0.85s;
      animation-timing-function: var(--ease-out);
      animation-delay: calc(var(--i, 0) * 70ms);
      animation-fill-mode: both;
    }
  }

  @keyframes grow-bar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
