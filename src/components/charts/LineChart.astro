---
import { useTranslations, type Lang } from '../../i18n/ui';
import { MONTHS, TREND_SERIES } from '../../lib/sample-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Change over time — the one job a line does better than anything else.
//
// Two series only. Past about four, lines converge and the direct end-labels
// stop pointing at anything; that is a small-multiples problem, not a legend
// problem.
//
// Geometry is computed here rather than in the browser so the chart is complete
// in the HTML: no JS, no chart, is not a trade this site makes.
const X0 = 52;
const X1 = 596; // stops short so the end labels sit inside the panel
const Y0 = 24;
const Y1 = 232;
const MAX = 32;

const sx = (i: number) => X0 + (i / (MONTHS.length - 1)) * (X1 - X0);
const sy = (v: number) => Y1 - (v / MAX) * (Y1 - Y0);

const months = MONTHS.map((_, i) =>
  new Date(2025, i, 1).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', { month: 'short' })
);

const series = TREND_SERIES.map((s, i) => ({
  name: t(`demo.series.${s.key}` as 'demo.series.organic'),
  hue: `var(--color-series-${i + 1})`,
  data: s.data,
  path: s.data.map((v, i2) => `${i2 ? 'L' : 'M'}${sx(i2).toFixed(1)} ${sy(v).toFixed(1)}`).join(' '),
}));

const ticks = [0, 8, 16, 24, 32];
const uid = 'ln';
---

<figure class="chart card" data-chart>
  <figcaption class="chart-cap">
    <div>
      <h3 class="chart-title">{t('demo.trend.title')}</h3>
      <p class="label mt-1.5">{t('demo.trend.unit')}</p>
    </div>
    {/* Two series, so a legend is not optional — identity must never rest on
        colour-matching alone. */}
    <ul class="chart-legend">
      {
        series.map((s) => (
          <li>
            <span class="key-line" style={`background:${s.hue}`} aria-hidden="true" />
            {s.name}
          </li>
        ))
      }
    </ul>
  </figcaption>

  <svg viewBox="0 0 700 268" role="img" aria-label={t('demo.trend.title')}>
    <defs>
      {/* The wipe clips a rectangle rather than scaling the marks, so the line
          weight and the end dots never distort while it plays. */}
      <clipPath id={`${uid}-wipe`}>
        <rect class="wipe-rect" x="0" y="0" width="700" height="268" />
      </clipPath>
    </defs>

    {
      ticks.map((v) => (
        <>
          <line class="gridline" x1={X0} y1={sy(v)} x2={X1} y2={sy(v)} />
          <text class="axis-text" x={X0 - 10} y={sy(v) + 4} text-anchor="end">
            {v}
          </text>
        </>
      ))
    }
    <line class="axisline" x1={X0} y1={Y1} x2={X1} y2={Y1}></line>
    {
      months.map((m, i) => (
        <text class="axis-text" x={sx(i)} y={Y1 + 22} text-anchor="middle">
          {m}
        </text>
      ))
    }

    <g clip-path={`url(#${uid}-wipe)`}>
      {
        series.map((s) => (
          <path
            d={s.path}
            fill="none"
            stroke={s.hue}
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        ))
      }
      {/* Label the endpoint only — a number on every point is chaos and goes
          unread. The axis and the tooltip carry the rest. */}
      {
        series.map((s) => {
          const i = s.data.length - 1;
          return (
            <>
              <circle
                cx={sx(i)}
                cy={sy(s.data[i])}
                r="4.5"
                fill={s.hue}
                stroke="var(--color-surface)"
                stroke-width="2"
              />
              <text class="mark-value" x={sx(i) + 12} y={sy(s.data[i]) + 4}>
                {s.data[i]}K
              </text>
            </>
          );
        })
      }
    </g>
  </svg>
</figure>

<style>
  .wipe-rect {
    transform-box: fill-box;
    transform-origin: left;
  }

  /* Hover replays the drawing. A distinct keyframe name from the reveal pass
     is what makes it restart every time rather than fire once. */
  @media (prefers-reduced-motion: no-preference) and (hover: hover) {
    .chart:hover .wipe-rect {
      animation-name: wipe-line;
      animation-duration: 1.1s;
      animation-timing-function: var(--ease-out);
      animation-fill-mode: both;
    }
  }

  @keyframes wipe-line {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
