---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;
const t = useTranslations(lang);

// One component, three placements (footer sitewide, end of each post, homepage
// close) — site-plan.md §8. Kit hosts the submission and the double opt-in;
// there is no server here to accept a POST.
//
// TODO(kit): replace with the real Kit form endpoint once the account exists.
// Until then the field is disabled rather than silently dropping addresses.
const KIT_FORM_ACTION = '';
const configured = KIT_FORM_ACTION !== '';
---

<form
  action={KIT_FORM_ACTION || undefined}
  method="post"
  class:list={['flex flex-col gap-2 sm:flex-row', className]}
  data-configured={configured ? 'true' : 'false'}
>
  <label class="sr-only" for={`newsletter-email-${lang}`}>
    {t('footer.newsletter.email')}
  </label>
  <input
    id={`newsletter-email-${lang}`}
    type="email"
    name="email_address"
    required
    disabled={!configured}
    autocomplete="email"
    placeholder={t('footer.newsletter.email')}
    class="min-w-0 flex-1 rounded-md border border-line bg-plane px-3.5 py-2.5 text-sm text-ink transition-colors placeholder:text-ink-3 hover:border-line-strong focus:border-accent disabled:opacity-50 disabled:hover:border-line"
  />
  <button type="submit" disabled={!configured} class="btn btn-ghost justify-center disabled:opacity-50">
    {t('footer.newsletter.submit')}
  </button>
</form>
{
  !configured && (
    <p class="mt-2.5 font-mono text-meta text-ink-3">
      Newsletter not connected yet — needs a Kit account.
    </p>
  )
}
