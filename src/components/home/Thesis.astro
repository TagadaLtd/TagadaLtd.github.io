---
interface Props {
  thesis: { label: string; body: string };
}

const { thesis } = Astro.props;

// The job of this section is one reaction: "that's us." So it stays prose, in
// the warm half of the design split — no cards, no icons, no columns. It is
// set at lead size because it is the only paragraph on the page that has to be
// read in full.
---

<section class="shell section-y">
  <div class="rule-t grid gap-x-10 gap-y-6 pt-10 md:grid-cols-[10rem_minmax(0,1fr)]" data-reveal-group>
    <p class="label md:pt-2" data-reveal>{thesis.label}</p>
    <p class="max-w-[46ch] text-lead text-ink" data-reveal>{thesis.body}</p>
  </div>
</section>
