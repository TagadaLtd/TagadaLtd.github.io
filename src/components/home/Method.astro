---
import Section from '../Section.astro';

interface Props {
  method: {
    label: string;
    title: string;
    beats: { step: string; title: string; body: string }[];
  };
}

const { method } = Astro.props;

// The signature moment (site-plan.md §4.3). Three beats, roughly one viewport
// each once the scroll sequence is built.
//
// What exists now is the static equivalent — three panels carrying the same
// content — because design-system.md forbids meaning living only in animation.
// Building this first rather than retrofitting it is deliberate: the fallback
// is the source of truth, and the motion pass animates on top of it.
---

<Section label={method.label} title={method.title} id="method">
  <ol class="grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-3">
    {
      method.beats.map((beat, i) => (
        <li class="flex flex-col bg-surface p-7">
          <div class="flex items-baseline gap-3">
            <span class="font-mono text-sm text-[color:var(--color-accent)]">{beat.step}</span>
            <span class="h-px flex-1 bg-line-strong" aria-hidden="true" />
          </div>
          <h3 class="mt-6 text-h3">{beat.title}</h3>
          <p class="mt-3 text-sm text-ink-2">{beat.body}</p>

          {/* Placeholder for the beat's visual — scatter, structure, chart.
              The motion pass replaces this block; the copy above stands alone. */}
          <div
            class="mt-8 h-24 rounded-md border border-dashed border-line"
            data-beat={i + 1}
            aria-hidden="true"
          />
        </li>
      ))
    }
  </ol>
</Section>
