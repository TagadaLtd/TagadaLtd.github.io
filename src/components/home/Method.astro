---
import Section from '../Section.astro';

interface Props {
  method: {
    label: string;
    title: string;
    beats: { step: string; title: string; body: string }[];
  };
}

const { method } = Astro.props;

// The signature moment (site-plan.md §4.3). Three beats, roughly one viewport
// each once the scroll sequence is built.
//
// What exists now is the static equivalent — three panels carrying the same
// content — because design-system.md forbids meaning living only in animation.
// Building this first rather than retrofitting it is deliberate: the fallback
// is the source of truth, and the motion pass animates on top of it.
//
// Each beat now carries its own mark instead of an empty dashed box: the same
// observations, scattered, then grouped, then acted on. The marks are abstract
// by design — no axes, no values, nothing that could be read as a claim about
// a real client. Never invent metrics (CLAUDE.md).

const rnd = (i: number, salt: number) => {
  const v = Math.sin(i * 91.7 + salt * 47.13) * 21753.19;
  return v - Math.floor(v);
};

// Beat 1 — scattered, duplicated, half-tagged. No structure to find yet.
const scatter = Array.from({ length: 22 }, (_, i) => ({
  x: (6 + rnd(i, 1) * 88).toFixed(1),
  y: (10 + rnd(i, 2) * 80).toFixed(1),
  o: (0.3 + rnd(i, 3) * 0.4).toFixed(2),
}));

// Beat 2 — the same population, resolved into groups. Series 2, 1 and 4 in the
// palette's fixed order, matching the three pillars: marketing, data, AI.
const CLUSTERS = [
  { cx: 22, cy: 62, hue: 'var(--color-series-2)' },
  { cx: 52, cy: 34, hue: 'var(--color-series-1)' },
  { cx: 79, cy: 66, hue: 'var(--color-series-4)' },
];
// Tight enough that three groups are legible at 110px tall — the point of the
// beat is that structure appeared, so overlapping clouds would say the opposite.
const clustered = CLUSTERS.flatMap((c, ci) =>
  Array.from({ length: 7 }, (_, i) => {
    const k = ci * 11 + i;
    return {
      x: (c.cx + (rnd(k, 4) - 0.5) * 15).toFixed(1),
      y: (c.cy + (rnd(k, 5) - 0.5) * 34).toFixed(1),
      hue: c.hue,
    };
  })
);

// Beat 3 — one option chosen out of the set. The chosen bar is the only warm
// thing in the row, the same way the primary button is.
const BARS = [34, 52, 41, 88, 46, 29, 58];
const CHOSEN = 3;
---

<Section label={method.label} title={method.title} icon="trend" id="method">
  <ol class="grid gap-px overflow-hidden rounded-lg border border-line bg-line md:grid-cols-3" data-reveal-group>
    {
      method.beats.map((beat, i) => (
        <li class="flex flex-col bg-surface p-7 lg:p-8" data-reveal>
          <div class="flex items-baseline gap-3">
            <span class="num text-sm text-accent">{beat.step}</span>
            <span class="h-px flex-1 bg-line-strong" aria-hidden="true" />
          </div>

          <h3 class="mt-6 text-h3">{beat.title}</h3>
          <p class="mt-3 text-sm text-ink-2">{beat.body}</p>

          <div class="relative mt-8 h-28" data-beat={i + 1} aria-hidden="true">
            {i === 0 &&
              scatter.map((p) => (
                <span
                  class="absolute size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-accent"
                  style={`left:${p.x}%;top:${p.y}%;opacity:${p.o}`}
                />
              ))}

            {i === 1 &&
              clustered.map((p) => (
                <span
                  class="absolute size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full"
                  style={`left:${p.x}%;top:${p.y}%;background:${p.hue}`}
                />
              ))}

            {i === 2 && (
              <div class="flex h-full items-end gap-2 border-b border-line-strong pb-px">
                {BARS.map((h, b) => (
                  <span
                    class="flex-1 rounded-t-[2px]"
                    style={`height:${h}%;background:${
                      b === CHOSEN ? 'var(--color-accent-warm)' : 'var(--color-line-strong)'
                    }`}
                  />
                ))}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</Section>
