---
import Section from '../Section.astro';
import type { Lang } from '../../i18n/ui';
import { localPath } from '../../i18n/paths';

interface Props {
  lang: Lang;
  pillars: {
    label: string;
    title: string;
    items: { title: string; body: string }[];
  };
}

const { lang, pillars } = Astro.props;

// Series 2, 1 and 4 — marketing, data, AI, the same three hues the Insight beat
// resolves into, so a reader who noticed the marks there recognises them here.
// Assigned in the palette's fixed order, never cycled.
const marks = ['var(--color-series-2)', 'var(--color-series-1)', 'var(--color-series-4)'];
---

<Section label={pillars.label} title={pillars.title} icon="ranges" tone="marketing">
  <ul class="grid gap-10 sm:grid-cols-3 sm:gap-8" data-reveal-group>
    {
      pillars.items.map((item, i) => (
        <li class="border-t border-line pt-6" data-reveal>
          {/* The coloured segment sits on the rule like a highlighted range on
              an axis. A coloured mark beside a label carries identity; the
              label itself stays in neutral ink (design-system.md). */}
          <span
            class="pillar-range -mt-6 mb-6 block h-0.5 w-10"
            style={`background:${marks[i % marks.length]}`}
            aria-hidden="true"
          />
          <h3 class="text-h3">{item.title}</h3>
          <p class="mt-3 max-w-[38ch] text-sm text-ink-2">{item.body}</p>
        </li>
      ))
    }
  </ul>

  <a href={localPath(lang, 'services')} class="link-arrow mt-12">
    {pillars.label}
    <span class="link-arrow-glyph" aria-hidden="true">→</span>
  </a>
</Section>
