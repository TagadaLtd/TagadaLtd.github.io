---
import Section from '../Section.astro';

interface Props {
  process: {
    label: string;
    title: string;
    steps: { title: string; body: string }[];
  };
}

const { process } = Astro.props;

// Freelance prospects hesitate because the process is opaque. Naming it removes
// the friction (site-plan.md §4.7) — so this is an ordered list, not a diagram.
//
// The numbers stay because these steps genuinely happen in order: you cannot
// hand over before the work. Ruled rows rather than filled cards, so the count
// reads as a sequence down the page instead of four boxes of equal weight.
---

<Section label={process.label} title={process.title} icon="flow">
  <ol class="grid gap-x-8 sm:grid-cols-2" data-reveal-group>
    {
      process.steps.map((step, i) => (
        <li class="flex gap-5 border-t border-line py-7" data-reveal>
          <span class="num shrink-0 pt-0.5 text-sm text-ink-3">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="text-h3">{step.title}</h3>
            <p class="mt-2.5 max-w-[42ch] text-sm text-ink-2">{step.body}</p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>
