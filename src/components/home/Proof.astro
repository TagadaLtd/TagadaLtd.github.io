---
import Section from '../Section.astro';

interface Props {
  proof: {
    label: string;
    stats: { value: string; label: string }[];
    certifications: string[];
  };
}

const { proof } = Astro.props;

// Reassurance, not spectacle (site-plan.md §4.6). Quiet strip, no animation.
---

<Section label={proof.label}>
  <dl class="grid gap-8 sm:grid-cols-3">
    {
      proof.stats.map((stat) => (
        <div>
          <dt class="sr-only">{stat.label}</dt>
          <dd>
            <span class="block font-mono text-h2 leading-none text-ink">{stat.value}</span>
            <span class="mt-3 block text-sm text-ink-2">{stat.label}</span>
          </dd>
        </div>
      ))
    }
  </dl>

  <ul class="mt-12 flex flex-wrap gap-2 border-t border-line pt-8">
    {
      proof.certifications.map((c) => (
        <li class="rounded-sm border border-line px-3 py-1.5 font-mono text-xs text-ink-3">{c}</li>
      ))
    }
  </ul>
</Section>
