---
import Section from '../Section.astro';

interface Props {
  proof: {
    label: string;
    stats: { value: string; label: string }[];
    certifications: string[];
  };
}

const { proof } = Astro.props;

// Reassurance, not spectacle (site-plan.md §4.6). Quiet strip, no animation.
// Figures are set in mono with tabular numerals — they are measurements, and
// they should look like readings rather than headlines.
---

<Section label={proof.label} icon="ticks" tone="proof">
  <dl class="grid gap-10 border-t border-line pt-10 sm:grid-cols-3 sm:gap-8" data-reveal-group>
    {
      proof.stats.map((stat) => (
        <div data-reveal>
          <dt class="sr-only">{stat.label}</dt>
          <dd>
            <span class="num block text-stat leading-none text-ink">{stat.value}</span>
            <span class="mt-4 block max-w-[24ch] text-sm text-ink-2">{stat.label}</span>
          </dd>
        </div>
      ))
    }
  </dl>

  <ul class="mt-14 flex flex-wrap gap-2 border-t border-line pt-8">
    {
      proof.certifications.map((c) => (
        <li class="rounded-sm border border-line px-2.5 py-1.5 font-mono text-meta text-ink-3">
          {c}
        </li>
      ))
    }
  </ul>
</Section>
