---
import type { GlyphName } from './glyphs';

interface Props {
  name: GlyphName;
  class?: string;
}

const { name, class: className = '' } = Astro.props;

// Section marks, drawn from the same vocabulary as the hero figure: axes,
// points, ranges, rules. Deliberately not a general-purpose icon set — a
// briefcase for Work and a pencil for Writing would be interchangeable with
// any other site's, and this one is about reading charts.
//
// Each mark says what its section does, not what its section is called:
//   trend    fitted line through points        — how I work
//   ranges   three bands on one axis           — three sides of one job
//   panels   small multiples                   — selected work
//   ticks    a measured scale                  — track record
//   flow     four nodes on a path              — the four steps
//   lines    ruled text                        — writing
//   scatter  unresolved points
//   target   a point located on two axes
//
// 16px grid, hairline strokes, currentColor. They inherit the label's colour,
// so a mark never carries a series hue (design-system.md).
---

<svg
  class:list={['glyph', className]}
  viewBox="0 0 16 16"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'trend' && (
      <>
        <path d="M2 13.5V2" class="glyph-axis" />
        <path d="M2 13.5h12" class="glyph-axis" />
        <path class="glyph-line" d="M3.5 12 13 4" />
        <circle cx="5" cy="9.6" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="8" cy="9" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="10.5" cy="5.6" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }

  {
    name === 'ranges' && (
      <>
        <path d="M2 13.5h12" class="glyph-axis" />
        <path d="M2.5 3.5h5" />
        <path d="M2.5 7h9" />
        <path d="M2.5 10.5h3.5" />
      </>
    )
  }

  {
    name === 'panels' && (
      <>
        <rect x="2" y="2" width="5.2" height="5.2" rx="0.8" />
        <rect x="8.8" y="2" width="5.2" height="5.2" rx="0.8" />
        <rect x="2" y="8.8" width="5.2" height="5.2" rx="0.8" />
        <rect x="8.8" y="8.8" width="5.2" height="5.2" rx="0.8" />
      </>
    )
  }

  {
    name === 'ticks' && (
      <>
        <path d="M2 11h12" class="glyph-axis" />
        <path d="M2 11V7.5M6 11V9M10 11V6M14 11V8.5" />
        <path d="M2 4.5h12" class="glyph-axis" />
      </>
    )
  }

  {
    name === 'flow' && (
      <>
        <path d="M3 12.5 6.2 8l3.2 2.4L13 3.5" />
        <circle cx="3" cy="12.5" r="1.1" />
        <circle cx="13" cy="3.5" r="1.1" />
      </>
    )
  }

  {
    name === 'lines' && (
      <>
        <path d="M2.5 3.5h11" />
        <path d="M2.5 7h11" />
        <path d="M2.5 10.5h6.5" />
      </>
    )
  }

  {
    name === 'scatter' && (
      <>
        <path d="M2 13.5V2" class="glyph-axis" />
        <path d="M2 13.5h12" class="glyph-axis" />
        <circle cx="5" cy="10" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="7.5" cy="5" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="10" cy="8.5" r="0.9" fill="currentColor" stroke="none" />
        <circle cx="12.5" cy="4" r="0.9" fill="currentColor" stroke="none" />
      </>
    )
  }

  {
    name === 'target' && (
      <>
        <path d="M2 13.5V2" class="glyph-axis" />
        <path d="M2 13.5h12" class="glyph-axis" />
        <path d="M2 5.5h8.5V13.5" class="glyph-axis" stroke-dasharray="1.6 1.6" />
        <circle cx="10.5" cy="5.5" r="1.6" />
      </>
    )
  }
</svg>

<style>
  .glyph {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  /* Axes sit behind the data, the same as they do in the hero figure. */
  .glyph-axis {
    opacity: 0.45;
  }
</style>
