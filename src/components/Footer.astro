---
import { useTranslations, type Lang } from '../i18n/ui';
import { localPath } from '../i18n/paths';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const nav = [
  { key: 'nav.work', href: localPath(lang, 'work') },
  { key: 'nav.services', href: localPath(lang, 'services') },
  { key: 'nav.about', href: localPath(lang, 'about') },
  { key: 'nav.blog', href: localPath(lang, 'blog') },
  { key: 'nav.contact', href: localPath(lang, 'contact') },
] as const;
---

<footer class="mt-24 border-t border-line">
  <div class="shell py-16">
    <div class="grid gap-14 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <h2 class="max-w-[20ch] text-h3">{t('footer.newsletter.title')}</h2>
        <p class="measure mt-4 text-sm text-ink-2">{t('footer.newsletter.body')}</p>
        <NewsletterForm lang={lang} class="mt-6" />
      </div>

      <nav aria-label="Footer">
        <p class="label">{t('nav.menu')}</p>
        <ul class="mt-5 space-y-2.5">
          {
            nav.map(({ key, href }) => (
              <li>
                <a href={href} class="text-sm text-ink-2 transition-colors hover:text-ink">
                  {t(key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="label">{t('footer.elsewhere')}</p>
        <ul class="mt-5 space-y-2.5 text-sm">
          <li>
            <a
              href="https://www.linkedin.com/in/sebastien-borgeslopes"
              rel="me noopener"
              class="text-ink-2 transition-colors hover:text-ink">LinkedIn</a
            >
          </li>
          <li>
            <a
              href="mailto:borgeslopes.sebastien@gmail.com"
              class="text-ink-2 transition-colors hover:text-ink">Email</a
            >
          </li>
        </ul>
        <p class="label mt-8">{t('footer.location')}</p>
      </div>
    </div>

    <div
      class="mt-16 flex flex-col gap-3 border-t border-line pt-7 text-xs text-ink-3 sm:flex-row sm:items-center sm:justify-between"
    >
      <p class="num">© {year} Sébastien Borges Lopes</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={localPath(lang, 'privacy')} class="transition-colors hover:text-ink-2">
          {t('footer.privacy')}
        </a>
        <span class="font-mono">{t('footer.built')}</span>
      </div>
    </div>
  </div>
</footer>
