---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaceholderBadge from '../../../components/PlaceholderBadge.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { localPath } from '../../../i18n/paths';
import { parseId } from '../../../lib/content';

export async function getStaticPaths() {
  // Drafts are included in dev and excluded from the built site, matching
  // lib/content.ts. Keeping the filter identical here is what stops a card from
  // linking at a page that does not exist.
  const entries = await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => {
    const { lang, slug } = parseId(entry.id);
    return { params: { lang, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(entry);
const d = entry.data;

const meta = [
  [t('work.sector'), d.sector],
  [t('work.scale'), d.scale],
  ['Role', d.role],
  ['Timeframe', d.timeframe],
  [t('work.year'), String(d.year)],
] as const;
---

<BaseLayout lang={lang} title={`${d.title} — Sébastien Borges Lopes`} description={d.summary}>
  <article class="mx-auto max-w-4xl px-5 py-16 sm:px-8 sm:py-24">
    {d.draft && <PlaceholderBadge lang={lang} />}

    <h1 class="text-h1">{d.title}</h1>
    <p class="mt-6 measure text-lead text-ink-2">{d.summary}</p>

    <dl class="mt-12 grid gap-6 rule-t pt-8 sm:grid-cols-3 lg:grid-cols-5">
      {
        meta.map(([label, value]) => (
          <div>
            <dt class="label">{label}</dt>
            <dd class="mt-2 text-sm text-ink">{value}</dd>
          </div>
        ))
      }
    </dl>

    {
      d.tools.length > 0 && (
        <ul class="mt-8 flex flex-wrap gap-2">
          {d.tools.map((tool) => (
            <li class="rounded-sm border border-line px-3 py-1.5 font-mono text-xs text-ink-3">
              {tool}
            </li>
          ))}
        </ul>
      )
    }

    {
      d.results.length > 0 && (
        <dl class="mt-14 grid gap-px overflow-hidden rounded-lg border border-line bg-line sm:grid-cols-2">
          {d.results.map((r) => (
            <div class="bg-surface p-7">
              <dd class="font-mono text-h2 leading-none text-[color:var(--color-accent)]">
                {r.value}
              </dd>
              <dt class="mt-4 text-sm text-ink-2">{r.label}</dt>
              {r.note && <p class="mt-2 text-xs text-ink-3">{r.note}</p>}
            </div>
          ))}
        </dl>
      )
    }

    <div class="prose-body mt-16">
      <Content />
    </div>

    <div class="mt-16 rule-t pt-10">
      <a
        href={localPath(lang, 'contact')}
        class="inline-block rounded-md bg-accent px-5 py-3 text-sm font-medium text-plane transition-opacity hover:opacity-90"
      >
        {
          lang === 'fr'
            ? 'Un problème similaire ? Parlons-en.'
            : 'Have a similar problem? Let’s talk.'
        }
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  /* Local prose rules. A full typography pass replaces these. */
  .prose-body :global(h2) {
    font-size: var(--text-h3);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-body :global(p) {
    max-width: 62ch;
    margin-bottom: 1rem;
    color: var(--color-ink-2);
  }
  .prose-body :global(strong) {
    color: var(--color-ink);
  }
</style>
