---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PlaceholderBadge from '../../../components/PlaceholderBadge.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import { useTranslations, type Lang } from '../../../i18n/ui';
import { parseId, readingTime } from '../../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft);
  return entries.map((entry) => {
    const { lang, slug } = parseId(entry.id);
    return { params: { lang, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const { Content } = await render(entry);

const minutes = readingTime(entry.body ?? '');
const date = entry.data.date.toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  lang={lang}
  title={`${entry.data.title} — Sébastien Borges Lopes`}
  description={entry.data.description}
>
  <article class="mx-auto max-w-3xl px-5 py-16 sm:px-8 sm:py-24">
    {entry.data.draft && <PlaceholderBadge lang={lang} />}

    <p class="label">{date} · {minutes} {t('blog.readingTime')}</p>
    <h1 class="mt-5 text-h1">{entry.data.title}</h1>
    <p class="mt-6 measure text-lead text-ink-2">{entry.data.description}</p>

    <div class="prose-body mt-14 rule-t pt-10">
      <Content />
    </div>

    <div class="mt-16 rule-t pt-10">
      <p class="label">{t('footer.newsletter.title')}</p>
      <NewsletterForm lang={lang} class="mt-4 max-w-md" />
    </div>
  </article>
</BaseLayout>

<style>
  .prose-body :global(h2) {
    font-size: var(--text-h3);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-body :global(p) {
    margin-bottom: 1rem;
    color: var(--color-ink-2);
  }
  .prose-body :global(a) {
    color: var(--color-accent);
  }
  .prose-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
