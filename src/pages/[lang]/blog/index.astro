---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import NewsletterForm from '../../../components/NewsletterForm.astro';
import { LANGS, useTranslations, type Lang } from '../../../i18n/ui';
import { getPosts } from '../../../lib/content';

export function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);

// The index must look intentional at three posts, not empty (site-plan.md §8).
// Hence a real intro line rather than a blank list.
const intro =
  lang === 'fr'
    ? 'Notes sur les données clients, la mesure, et l’automatisation — en français et en anglais, toujours les deux.'
    : 'Notes on customer data, measurement, and automation — in French and English, always both.';
---

<BaseLayout lang={lang} title={`${t('nav.blog')} — Sébastien Borges Lopes`} description={intro}>
  <PageHeader lang={lang} title={t('nav.blog')} intro={intro} />

  <section class="shell section-y">
    <div class="grid gap-10 md:grid-cols-3" data-reveal-group>
      {posts.map((entry) => <PostCard lang={lang} entry={entry} />)}
    </div>

    {
      posts.length === 0 && (
        <p class="measure text-ink-2">
          {lang === 'fr' ? 'Rien de publié pour l’instant.' : 'Nothing published yet.'}
        </p>
      )
    }

    <div class="rule-t mt-20 pt-10">
      <p class="label">{t('footer.newsletter.title')}</p>
      <NewsletterForm lang={lang} class="mt-4 max-w-md" />
    </div>
  </section>
</BaseLayout>
